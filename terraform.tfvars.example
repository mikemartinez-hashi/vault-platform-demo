# Copy to terraform.tfvars (local) or set as HCP Terraform workspace variables.
#
# REQUIRED, no defaults - Terraform prompts on the CLI and HCP Terraform refuses
# to plan until they are set. Mark both sensitive on the workspace:
#   demo_password         Act 1 userpass login for var.demo_username
#   mysql_root_password   Act 4 MariaDB root password
#
# Optional but sensitive if you set them: db_master_password, sample_api_key,
# ci_kv_secret_value.
#
# Provider creds go in as ENVIRONMENT variables on the workspace, not here:
#   AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY    (or a dynamic provider credential)
#   VAULT_ADDR, VAULT_TOKEN, VAULT_NAMESPACE    (VAULT_NAMESPACE usually "admin")

# --- The one knob that re-skins the whole demo ---
customer_name = "demo"          # e.g. "advent", "fadv" — prefixes all mounts/roles

# --- AWS ---
aws_region = "us-east-1"
key_name   = "linux-demo-kp"    # an existing EC2 key pair in this region

# --- Vault (connection only; auth is via VAULT_TOKEN env var) ---
vault_addr      = "https://<your-cluster>.hashicorp.cloud:8200"
vault_namespace = "admin"
vault_version   = "1.21.3"       # MUST match your HCP Vault server version (Act 4 agent)

# --- Act 2: RDS reachability ---
# REQUIRED. Include your HCP Vault cluster egress IP (HCP portal > your Vault
# cluster) AND your own public IP, each as /32. Demo-only — never leave 0.0.0.0/0.
db_allowed_cidrs = [
  # "<HCP_VAULT_EGRESS_IP>/32",
  # "<YOUR_PUBLIC_IP>/32",
]

# --- Act 1: KV demo login (the "appuser" identity) ---
demo_username = "appuser"
demo_password = ""              # REQUIRED, min 12 chars, throwaway. Mark sensitive.

# Short TTL = a live "watch it expire" moment; longer = revoke live instead.
# 300 = 5 min: long enough to demo, short enough that leases are gone by teardown.
db_cred_ttl_seconds     = 300
db_cred_max_ttl_seconds = 86400

# --- Act 2: RDS master password ---
# Optional. Leave it out entirely and Terraform generates a 24-char password -
# read it back with `terraform output -raw db_master_password`. Set it only if
# you want to know the value up front (e.g. to paste into psql on a shared
# screen). RDS rejects '/', '@', '"' and whitespace; 8-128 chars.
# db_master_password = ""       # Mark sensitive if you set it.

# --- Act 4: PKI + Vault Agent (Windows MariaDB) ---
pki_common_name     = "mysql.demo.internal"
server_cert_ttl     = "72h"      # short = visible rotation on renewal
mysql_root_password = ""         # REQUIRED, min 12 chars, throwaway. Mark sensitive.

# --- Act 5: agentless PKI rotation (Ubuntu + nginx) ---
# Same intermediate CA as Act 4; the client is a systemd timer + curl, no agent.
# Defaults below are deliberately aggressive so rotation is visible in a demo
# slot: a 1h cert re-issued once it drops under 45m left ≈ every 15 minutes.
agentless_common_name             = "web.demo.internal"
agentless_cert_ttl                = "1h"
agentless_renew_threshold_seconds = 2700   # re-issue with < 45 min of life left
agentless_rotate_interval         = "5min" # how often the timer checks
agentless_web_instance_type       = "t3.micro"
